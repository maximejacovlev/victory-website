{%- comment -%}
  Simple SVG bottle placeholder.
  Accepts: kind ('rose' | 'gin'), name (string)
{%- endcomment -%}

{%- if kind == 'gin' -%}
  <svg class="bottle-svg" viewBox="0 0 80 280" aria-hidden="true">
    <rect x="35" y="6"  width="10" height="36" fill="#1a1411"/>
    <rect x="31" y="2"  width="18" height="12" fill="#3a2e26"/>
    <path d="M28 42 L52 42 L62 80 L62 270 Q40 276 18 270 L18 80 Z" fill="#d6cfb4"/>
    <path d="M28 42 L52 42 L62 80 L62 270 Q40 276 18 270 L18 80 Z" fill="url(#ginG)" opacity=".55"/>
    <defs>
      <linearGradient id="ginG" x1="0" x2="1">
        <stop offset="0" stop-color="#fff" stop-opacity=".4"/>
        <stop offset=".5" stop-color="#fff" stop-opacity="0"/>
        <stop offset="1" stop-color="#000" stop-opacity=".3"/>
      </linearGradient>
    </defs>
    <rect x="20" y="130" width="40" height="100" fill="#1a1411"/>
    <text x="40" y="160" text-anchor="middle" font-family="Cormorant Garamond, serif" font-style="italic" font-size="11" fill="#f5efe6">{{ name | default: 'Aurore' }}</text>
    <text x="40" y="176" text-anchor="middle" font-family="JetBrains Mono, monospace" font-size="3.5" letter-spacing="1" fill="#e8c7b8">FORÊT</text>
    <line x1="26" y1="184" x2="54" y2="184" stroke="#e8c7b8" stroke-width=".3"/>
    <text x="40" y="196" text-anchor="middle" font-family="JetBrains Mono, monospace" font-size="3" letter-spacing=".6" fill="#e8c7b8">BOTANICAL GIN</text>
    <text x="40" y="212" text-anchor="middle" font-family="JetBrains Mono, monospace" font-size="3" letter-spacing=".6" fill="#e8c7b8">44% · 50CL</text>
  </svg>
{%- else -%}
  <svg class="bottle-svg" viewBox="0 0 80 280" aria-hidden="true">
    <rect x="35" y="6"  width="10" height="40" fill="#3d0f0f"/>
    <rect x="33" y="2"  width="14" height="10" fill="#1a1411"/>
    <path d="M30 46 Q40 48 50 46 L62 80 L62 270 Q40 278 18 270 L18 80 Z" fill="#e9b8a3"/>
    <path d="M30 46 Q40 48 50 46 L62 80 L62 270 Q40 278 18 270 L18 80 Z" fill="url(#roseG)" opacity=".55"/>
    <defs>
      <linearGradient id="roseG" x1="0" x2="1">
        <stop offset="0" stop-color="#fff" stop-opacity=".5"/>
        <stop offset=".4" stop-color="#fff" stop-opacity="0"/>
        <stop offset="1" stop-color="#000" stop-opacity=".25"/>
      </linearGradient>
    </defs>
    <rect x="22" y="140" width="36" height="80" fill="#faf6ee"/>
    <text x="40" y="170" text-anchor="middle" font-family="Cormorant Garamond, serif" font-style="italic" font-size="10" fill="#5c1a1a">{{ name | default: 'Aurore' }}</text>
    <text x="40" y="184" text-anchor="middle" font-family="JetBrains Mono, monospace" font-size="4" letter-spacing="1" fill="#5c1a1a">N° 07</text>
    <line x1="28" y1="192" x2="52" y2="192" stroke="#5c1a1a" stroke-width=".4"/>
    <text x="40" y="204" text-anchor="middle" font-family="JetBrains Mono, monospace" font-size="3.5" letter-spacing=".5" fill="#5c1a1a">ROSÉ — 2024</text>
  </svg>
{%- endif -%}
