<section class="section collection" style="padding-top:160px">
  <div class="container">
    <div class="collection-head">
      <h2 class="h-l lead">{{ collection.title }}</h2>
      <span class="meta">{{ collection.products_count }} {{ collection.products_count | pluralize: 'bottle', 'bottles' }}</span>
    </div>

    {%- if collection.description != blank -%}
      <p class="body-l" style="max-width:60ch;margin-bottom:64px">{{ collection.description }}</p>
    {%- endif -%}

    <div class="products">
      {%- for product in collection.products -%}
        {%- render 'product-card', product: product, index: forloop.index -%}
      {%- else -%}
        <p>No products in this collection yet.</p>
      {%- endfor -%}
    </div>
  </div>
</section>
